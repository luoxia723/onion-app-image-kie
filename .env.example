# 复制为 .env。Key 只保存在本机，设置接口不会回传。
KIE_API_KEY=""
KIE_BASE_URL="https://api.kie.ai"
KIE_UPLOAD_BASE_URL="https://kieai.redpandaai.co"
ONION_PLANNING_API_KEY=""
ONION_PLANNING_BASE_URL="https://ops-ai-gateway.yc345.tv/v1"
ONION_PLANNING_MODEL="gpt-6.1-terra"
# 并发固定 20。
# 保存位置必须是已存在的绝对路径；不配置时使用项目目录。
# ONION_IMAGE_WORKSPACE="/absolute/path"
# 默认只模拟图片；画面规划仍真实调用以上语言模型 API。
# 设置中填入 KIE Key 并保存会自动启用真实生图；也可显式选择模拟预览。
ONION_REAL_MODE="false"

# 新任务默认图片模型：gpt-image-2-5-sunburst-image-to-image 或 gpt-image-2-image-to-image，均为1K
ONION_IMAGE_MODEL=gpt-image-2-5-sunburst-image-to-image
